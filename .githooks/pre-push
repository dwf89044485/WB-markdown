#!/bin/bash
# pre-push hook: 推送时自动创建版本号递增 commit
# 版本号格式: 日本关西旅行策划 v0.x → v0.x+1
# 安装: git config core.hooksPath .githooks

set -e

INDEX="index.html"

# 检查工作区是否有未提交的改动（除了 index.html 本身）
# 如果有，先让用户处理，避免 hook 自动 commit 混入未完成的工作
if ! git diff --quiet --cached -- "$INDEX" 2>/dev/null; then
  # index.html 已在暂存区有改动，跳过（避免重复递增）
  exit 0
fi

# 匹配当前版本号
CURRENT=$(grep -oP '日本关西旅行策划 v0\.\K\d+' "$INDEX" 2>/dev/null || echo "")

if [ -z "$CURRENT" ]; then
  echo ""
  echo "  ⚠️  [pre-push] 未找到版本号 (日本关西旅行策划 v0.x)，跳过自动递增"
  echo ""
  exit 0
fi

NEXT=$((CURRENT + 1))

# 精确替换版本号
sed -i '' "s/日本关西旅行策划 v0\.$CURRENT/日本关西旅行策划 v0.$NEXT/" "$INDEX"

echo ""
echo "  🔢  [pre-push] 版本号自动递增: v0.$CURRENT → v0.$NEXT"
echo ""

git add "$INDEX"
git commit -m "chore: 版本号 v0.$CURRENT → v0.$NEXT [auto]"
